{
  "sourceLanguage": "en",
  "strings": {
  "Includes %lld subtitles located from surrounding narration. Their highlights may be approximate.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Includes %lld subtitles located from surrounding narration. Their highlights may be approximate."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "其中 %lld 条字幕依据前后文定位，高亮范围可能有偏差。"
        }
      }
    }
  },
