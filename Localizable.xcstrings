    "The saved Jimaku API key will be removed from this Mac.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The saved Jimaku API key will be removed from this Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将从这台 Mac 移除已保存的 Jimaku API 密钥。"}}}},
    "The API key is stored in macOS Keychain and is sent only to Jimaku API requests.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The API key is stored in macOS Keychain and is sent only to Jimaku API requests."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"API 密钥存储在 macOS 钥匙串中，仅随 Jimaku API 请求发送。"}}}},
    "Jimaku search and downloads require a Jimaku account and are subject to Jimaku's rate limits.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Jimaku search and downloads require a Jimaku account and are subject to Jimaku's rate limits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Jimaku 搜索和下载需要 Jimaku 账户，并受其速率限制约束。"}}}},
