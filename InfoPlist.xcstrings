            "state" : "translated",
            "value" : "Allow Niratan to access AnkiConnect, Suwayomi Server, Jellyfin, Emby and Plex media servers, Fushi interconnect hosts, and user-installed Aidoku sources on your local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
