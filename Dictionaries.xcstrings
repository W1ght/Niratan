{
  "sourceLanguage": "en",
  "strings": {
    "Kanji": {
      "comment": "Context: Settings > Dictionaries main screen. Surrounding UI includes recommended dictionary download/update alerts, a dictionary type segmented picker, and the installed dictionary list.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汉字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "漢字"
          }
        }
      }
    },
    "Yomitan term, frequency, pitch and kanji dictionaries (.zip) are supported": {
      "comment": "Context: Settings > Dictionaries main screen. Surrounding UI includes recommended dictionary download/update alerts, a dictionary type segmented picker, and the installed dictionary list.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Yomitan 词条、词频、音调和汉字词典（.zip）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 Yomitan 詞條、詞頻、音調和漢字辭典（.zip）"
          }
        }
      }
    },
    "Stroke Order Font": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔顺字体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆順字型"
          }
        }
      }
    },
    "Installed": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝"
          }
        }
      }
    },
    "Shows stroke order diagrams for the character in kanji entries.": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在汉字条目中显示该字的笔顺图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在漢字條目中顯示該字的筆順圖。"
          }
        }
      }
    },
    "Downloading Stroke Order Font": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载笔顺字体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下載筆順字型"
          }
        }
      }
    },
    "Download Font": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载字体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載字型"
          }
        }
      }
    },
    "This will download and automatically import the kanji stroke order font (17 MB).": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将下载并自动导入汉字笔顺字体（17 MB）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將下載並自動匯入漢字筆順字型（17 MB）。"
          }
        }
      }
    },
    "Failed to download the stroke order font": {
      "comment": "Context: Settings > Dictionaries kanji section. Downloads the optional kanji stroke order font used by kanji entries in lookup popups.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔顺字体下载失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆順字型下載失敗"
          }
        }
      }
    },
    "Apply Defaults": {
      "comment": "Context: Settings > Anki. Restores the selected supported note type using media fields shared by EPUB and Video mining.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用默认映射"
          }
        }
      }
    },
    "Apply defaults?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用默认映射？"
          }
        }
      }
    },
    "This will download the following recommended dictionaries:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将下载以下推荐词典："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將下載以下推薦辭典："
          }
        }
      }
    },
    "Address": {
      "comment": "Context: Settings > AnkiConnect. Surrounding UI configures server address, connection status, duplicate scope, model checks, and forced sync behavior.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "API Key (optional)": {
      "comment": "Context: Settings > AnkiConnect. Optional secret used when the AnkiConnect add-on is configured to require an API key.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥（可选）"
          }
        }
      }
    },
    "Allow Duplicates": {
      "comment": "Context: Settings > Anki. Surrounding UI configures Anki deck/model selection, backup import, duplicate handling, field mappings, tags, and fetch confirmation alerts.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许重复"
          }
        }
      }
    },
    "All dictionaries are already up to date.": {
      "comment": "Context: Settings > Dictionaries update check. Shown after checking remote dictionary revisions when no installed dictionary has a newer remote revision.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有词典都已经是最新版本。"
          }
        }
      }
    },
    "Arranges glossaries in two columns. Only recommended when used with full-width or on larger screens.": {
      "comment": "Context: Settings > Dictionaries > Behaviour. Guidance for the optional two-column glossary-card layout.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将词典释义排列为两栏。建议仅在全宽或较大的查词框中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將詞典釋義排列為兩欄。建議僅在全寬或較大的查詞框中使用。"
          }
        }
      }
    },
    "Anime Card Fields": {
      "comment": "Context: Settings > Anki. Video-only helper section for mapping Anki fields to subtitle mining placeholders.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动漫卡字段"
          }
        }
      }
    },
    "Anki": {
      "comment": "Context: Settings > Anki. Surrounding UI configures Anki deck/model selection, backup import, duplicate handling, field mappings, tags, and fetch confirmation alerts.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki"
          }
        }
      }
    },
    "AnkiConnect": {
      "comment": "Context: Settings > AnkiConnect. Surrounding UI configures server address, connection status, duplicate scope, model checks, and forced sync behavior.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnkiConnect"
          }
        }
      }
    },
    "AnkiConnect Status: %@": {
      "comment": "Context: Settings > Anki. Surrounding UI configures Anki deck/model selection, backup import, duplicate handling, field mappings, tags, and fetch confirmation alerts.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AnkiConnect 状态：%@"
          }
        }
      }
    },
    "AnkiMobile or an AnkiConnect instance is required to mine words.": {
      "comment": "Context: Settings > Anki. Surrounding UI configures Anki deck/model selection, backup import, duplicate handling, field mappings, tags, and fetch confirmation alerts.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要连接AnkiMobile 或 AnkiConnect 才能制卡。"
          }
        }
      }
    },
    "Apply Anime Card Preset": {
      "comment": "Context: Settings > Anki. Button that fills common Anki field mappings for video/anime mining.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套用动漫卡预设"
